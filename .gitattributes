# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts MUST be LF or the shebang breaks on Linux/WSL
*.sh           text eol=lf
*.bash         text eol=lf

# Other Unix-only formats that should never get CRLF
Makefile       text eol=lf
*.mk           text eol=lf

# Windows-only scripts stay CRLF
*.ps1          text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf
